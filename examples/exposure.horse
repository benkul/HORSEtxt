# a photograph develops if you hold still long enough.
#
# the `stand` primitive: an input that withholds motion rather than producing it.
# hold the pointer inside a small radius for ten seconds and an image surfaces.
# drift, or leave, and nothing happened -- not an error, and not a failure.
#
# the shape matters. the lead mare does not stand on anything: it hands `develop`
# to the page and stops. standing is what happens when someone arrives, and a
# program that stood at load would hold still against nobody.

@ juniper  left bias

band exposure

    remember hold as 10s
    remember jitter as 20px

    # the plate does not gather light evenly. exponential, topping out short of
    # black so the thing being held still on is still legible under it.
    cue plate t
        remember climbed as (hands.Math.exp (t * 1.5)) - 1
        remember full as (hands.Math.exp 1.5) - 1
        release (climbed / full) * 0.8

    cue develop i
        # one plate at a time. a second exposure over a showing one has nothing
        # to develop onto.
        when (hands.EN_EXPOSURE.busy)
            balk

        stand hold within jitter as held
            # the pointer left the row it started on. a row can be wider than the
            # jitter radius, so leaving is a different fact from drifting twenty
            # pixels, and either one ends the exposure.
            #
            # a balk here ends the cue, so the exposure stops rather than
            # going on developing against nobody.
            when not (hands.EN_EXPOSURE.inside i)
                balk

            hands.EN_EXPOSURE.shade i (plate held)
            ^ ears forward   eyes narrowed   lids AU143   head ~0.0   tension ~held ^
        otherwise
            # the hold broke. nothing happened, and nothing is wrong.
            hands.EN_EXPOSURE.clear i
            balk

        hands.EN_EXPOSURE.clear i

        # ten seconds of holding still, and then the animal looks up.
        ^ ears forward   eyes wide   nostrils AD38   head ~0.6   tension ~0.5 ^

        release hands.EN_EXPOSURE.reveal (hands.EN_EXPOSURE.srcOf i)

    lead mare watch-the-rows
        ^ ears divided   head ~0.05   tension ~0.02 _
        hands.EN_EXPOSURE.attach develop
        release
